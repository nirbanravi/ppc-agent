{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ads/run.schema.json",
  "title": "Ads skill run record",
  "description": "One immutable record per /ads run. Rendered to Markdown and HTML; never edited after finalize (create a new revision instead).",
  "type": "object",
  "required": ["schema_version", "run_id", "command", "status", "created_at", "client", "scope", "sources", "data_gaps", "errors", "summary", "findings", "integrity"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z]+-[a-z0-9-]+-[0-9a-f]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": ["string", "null"]},
    "command": {"enum": ["audit", "plan", "create", "monitor", "optimize", "experiment", "report", "validate"]},
    "status": {"enum": ["complete", "partial", "failed"]},
    "status_reason": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "finalized_at": {"type": ["string", "null"], "format": "date-time"},
    "skill_version": {"type": "string"},
    "client": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "currency": {"type": "string"},
        "timezone": {"type": "string"},
        "targets": {"type": "object"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["platforms"],
      "properties": {
        "platforms": {"type": "array", "items": {"$ref": "#/$defs/platform"}},
        "accounts": {"type": "array", "items": {"type": "string"}},
        "date_range": {"$ref": "#/$defs/date_range"},
        "question": {"type": "string"}
      }
    },
    "sources": {
      "type": "object",
      "required": ["data", "docs"],
      "properties": {
        "data": {"type": "array", "items": {"$ref": "#/$defs/data_source"}},
        "docs": {"type": "array", "items": {"$ref": "#/$defs/doc_source"}}
      }
    },
    "data_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "summary": {
      "type": "object",
      "required": ["headline"],
      "properties": {
        "headline": {"type": "string"},
        "key_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "overall_confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "plan": {"type": ["object", "null"]},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "pacing": {"type": "array", "items": {"$ref": "#/$defs/pacing_row"}},
    "changeset_ids": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "integrity": {
      "type": "object",
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": {"type": "string"},
        "inputs_sha256": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "platform": {"enum": ["google", "meta", "youtube", "linkedin", "tiktok", "microsoft", "amazon", "reddit", "pinterest", "snapchat", "apple", "x", "unknown"]},
    "date_range": {
      "type": "object",
      "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "days": {"type": "integer"}}
    },
    "data_source": {
      "type": "object",
      "required": ["id", "kind", "platform", "sha256", "rows", "freshness"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["export", "api_pull", "mcp_pull", "manual", "crm", "analytics"]},
        "platform": {"$ref": "#/$defs/platform"},
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "rows": {"type": "integer"},
        "report_type": {"type": "string"},
        "date_range": {"$ref": "#/$defs/date_range"},
        "pulled_at": {"type": ["string", "null"]},
        "freshness": {"enum": ["fresh", "aging", "stale", "unknown"]},
        "columns_present": {"type": "array", "items": {"type": "string"}},
        "columns_missing": {"type": "array", "items": {"type": "string"}},
        "currency": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "doc_source": {
      "type": "object",
      "required": ["url", "verified_at"],
      "properties": {
        "url": {"type": "string"},
        "title": {"type": "string"},
        "verified_at": {"type": ["string", "null"]},
        "stale": {"type": "boolean"},
        "used_for": {"type": "string"}
      }
    },
    "gap": {
      "type": "object",
      "required": ["what", "impact"],
      "properties": {
        "what": {"type": "string"},
        "impact": {"type": "string"},
        "blocks_checks": {"type": "array", "items": {"type": "string"}},
        "how_to_fix": {"type": "string"},
        "severity": {"enum": ["blocking", "major", "minor"]}
      }
    },
    "error": {
      "type": "object",
      "required": ["stage", "message"],
      "properties": {
        "stage": {"type": "string"},
        "source_id": {"type": "string"},
        "message": {"type": "string"},
        "recoverable": {"type": "boolean"}
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": "string"},
        "kind": {"enum": ["observed", "estimated"]},
        "source_id": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "detail"],
      "properties": {
        "source_id": {"type": "string"},
        "selector": {"type": "string", "description": "Which rows: e.g. campaign='Brand - Exact', date 2026-09-01..2026-09-30"},
        "detail": {"type": "string"},
        "values": {"type": "object"},
        "url": {"type": "string"}
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "score", "reasons"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "title", "category", "severity", "kind", "platform", "evidence", "confidence", "origin"],
      "properties": {
        "id": {"type": "string"},
        "check_id": {"type": "string"},
        "origin": {"enum": ["computed", "analyst"]},
        "title": {"type": "string"},
        "category": {"enum": ["tracking", "budget", "bidding", "structure", "targeting", "creative", "search_terms", "pacing", "performance", "measurement", "policy", "data_quality", "other"]},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "kind": {"enum": ["observed", "estimated", "recommendation"]},
        "platform": {"$ref": "#/$defs/platform"},
        "entity": {"type": "string"},
        "description": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "impact": {
          "type": "object",
          "properties": {
            "metric": {"type": "string"},
            "low": {"type": "number"},
            "high": {"type": "number"},
            "unit": {"type": "string"},
            "method": {"type": "string"}
          }
        },
        "recommendation": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "doc_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["id", "hypothesis", "platform", "primary_metric", "design", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "hypothesis": {"type": "string"},
        "platform": {"$ref": "#/$defs/platform"},
        "primary_metric": {"type": "string"},
        "guardrail_metrics": {"type": "array", "items": {"type": "string"}},
        "design": {"type": "string"},
        "mde": {"type": ["string", "null"]},
        "estimated_duration_days": {"type": ["number", "null"]},
        "budget_needed": {"type": ["number", "null"]},
        "decision_rule": {"type": "string"},
        "priority": {"type": "string"},
        "based_on_findings": {"type": "array", "items": {"type": "string"}},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "pacing_row": {
      "type": "object",
      "required": ["entity", "platform", "budget", "spend_to_date", "expected_to_date", "pace_pct", "status"],
      "properties": {
        "entity": {"type": "string"},
        "platform": {"$ref": "#/$defs/platform"},
        "period": {"type": "string"},
        "budget": {"type": "number"},
        "spend_to_date": {"type": "number"},
        "expected_to_date": {"type": "number"},
        "projected_end": {"type": "number"},
        "pace_pct": {"type": "number"},
        "status": {"enum": ["on_track", "under", "over", "at_risk", "unknown"]},
        "source_id": {"type": "string"}
      }
    }
  }
}
